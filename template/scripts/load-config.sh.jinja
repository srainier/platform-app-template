#!/usr/bin/env bash
# Store this app's SaaS values as Pulumi config without printing them.
#
# Reads a private hand-off file (default ~/.config/platform/apps/{{ app_name }}.env,
# chmod 600) holding single-quoted KEY='value' lines. See the new-app guide,
# Step 0, in platform-app-template. Delete the file once this succeeds.
set -euo pipefail

FILE="${1:-${HOME}/.config/platform/apps/{{ app_name }}.env}"
[[ -r "${FILE}" ]] || { echo "ERROR: ${FILE} not found." >&2; exit 1; }
perm="$(stat -f %Lp "${FILE}" 2>/dev/null || stat -c %a "${FILE}")"
if [[ "${perm}" != "600" && "${perm}" != "400" ]]; then
  echo "ERROR: ${FILE} is mode ${perm}; run: chmod 600 '${FILE}'" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
. "${FILE}"
set +a

cd "$(dirname "$0")/../infra"

store() {  # store <config-key> <env-var> [--secret]
  local key="$1" var="$2" flag="${3:-}" val
  val="${!var:-}"
  if [[ -z "${val}" ]]; then
    echo "ERROR: ${var} is missing or empty in ${FILE}" >&2
    exit 1
  fi
  # shellcheck disable=SC2086
  printf '%s' "${val}" | pulumi config set ${flag} "${key}" --stack prod
  echo "  stored ${key}"
}

store clerk_secret_key CLERK_SECRET_KEY --secret
{%- if include_frontend %}
store clerk_publishable_key CLERK_PUBLISHABLE_KEY
{%- endif %}
store flagsmith_api_key FLAGSMITH_API_KEY --secret
store sentry_dsn SENTRY_DSN --secret
store honeycomb_api_key HONEYCOMB_API_KEY --secret
echo "Done. Next: bash scripts/check-config.sh, then commit infra/Pulumi.prod.yaml."
