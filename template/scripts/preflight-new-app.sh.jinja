#!/usr/bin/env bash
set -euo pipefail

APP_NAME="{{ app_name }}"
REPO="{{ github_handle }}/{{ app_name }}"
PLATFORM_STACK="{{ pulumi_org }}/platform-infra/prod"
# Recommended home for the app-deployer token (see the new-app guide).
TOKEN_FILE="${HOME}/.config/platform/app-deployer.token"

echo "=== ${APP_NAME} new-app preflight ==="
echo ""
echo "Required runtime values to collect before deploy:"
echo "  PULUMI_ACCESS_TOKEN              Pulumi token for this app stack"
echo "  DIGITALOCEAN_TOKEN               app-deployer DO token, or admin token if you own infra"
echo "  CLERK_SECRET_KEY                 Clerk Development secret key (sk_test_...)"
{% if include_frontend %}
echo "  CLERK_PUBLISHABLE_KEY            Clerk Development publishable key (pk_test_...)"
{% endif %}
echo "  FLAGSMITH_API_KEY                Flagsmith server-side environment key, not an admin token"
echo "  SENTRY_DSN                       Sentry project DSN"
echo "  HONEYCOMB_API_KEY                Honeycomb ingest key, not a configuration key"
echo ""
echo "Optional setup-only tokens for scripts/setup-saas.sh:"
echo "  FLAGSMITH_SERVER_API_KEY         Only if creating a new Flagsmith project"
echo "  SENTRY_AUTH_TOKEN + SENTRY_ORG   Only if creating a new Sentry project"
echo "  HONEYCOMB_CONFIGURATION_API_KEY  Only if pre-creating a Honeycomb dataset"
echo ""

echo "Checking GitHub CLI auth..."
gh auth status >/dev/null

echo "Checking GitHub repo ${REPO}..."
repo_json="$(gh repo view "${REPO}" --json defaultBranchRef,isEmpty,nameWithOwner,visibility)"
echo "${repo_json}"

if echo "${repo_json}" | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin)["defaultBranchRef"] else 1)'; then
  echo "GitHub repo has a default branch."
else
  echo "ERROR: GitHub repo has no default branch yet. Push main before pulumi up." >&2
  exit 1
fi

echo ""
echo "Checking Pulumi login and read access to ${PLATFORM_STACK}..."
pulumi whoami >/dev/null || { echo "ERROR: run 'pulumi login' first." >&2; exit 1; }
pulumi stack output do_region --stack "${PLATFORM_STACK}" >/dev/null || {
  echo "ERROR: can't read ${PLATFORM_STACK}. Ask the platform admin to add you to" >&2
  echo "       the app-owners team (platform-infra README: Granting a new app-owner)." >&2
  exit 1
}

echo "Checking the DigitalOcean token..."
if [[ -z "${DIGITALOCEAN_TOKEN:-}" && -r "${TOKEN_FILE}" ]]; then
  DIGITALOCEAN_TOKEN="$(cat "${TOKEN_FILE}")"
fi
if [[ -z "${DIGITALOCEAN_TOKEN:-}" ]]; then
  echo "ERROR: no DigitalOcean token. Save the app-deployer token to ${TOKEN_FILE}" >&2
  echo "       (chmod 600) or export DIGITALOCEAN_TOKEN." >&2
  exit 1
fi
do_status="$(curl -s -o /dev/null -w '%{http_code}' \
  -H "Authorization: Bearer ${DIGITALOCEAN_TOKEN}" \
  "https://api.digitalocean.com/v2/apps?per_page=1")"
if [[ "${do_status}" != "200" ]]; then
  echo "ERROR: DigitalOcean token rejected listing apps (HTTP ${do_status}). It needs app:read." >&2
  exit 1
fi
echo "DigitalOcean token OK."

echo "Checking GitHub Actions secrets (needed for CI deploys)..."
secrets="$(gh secret list --repo "${REPO}" --json name --jq '.[].name' 2>/dev/null || true)"
for name in PULUMI_ACCESS_TOKEN DIGITALOCEAN_TOKEN; do
  if grep -qx "${name}" <<<"${secrets}"; then
    echo "  ${name}: set"
  else
    echo "  ${name}: MISSING (set it before relying on CI; deploys are skipped until then)"
  fi
done

echo ""
echo "Manual DigitalOcean check:"
echo "  If ${REPO} is private, confirm the DigitalOcean GitHub app has access to it."
echo "  In GitHub: Settings -> Applications -> Installed GitHub Apps -> DigitalOcean."
echo "  Stop on DigitalOcean's create-app page; Pulumi creates the app."
echo ""
echo "Preflight complete."
