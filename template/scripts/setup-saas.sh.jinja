#!/usr/bin/env bash
set -euo pipefail

APP_NAME="{{ app_name }}"
APP_DISPLAY_NAME="{{ app_display_name }}"

echo "=== ${APP_DISPLAY_NAME} — SaaS Setup ==="
echo ""
echo "This helper can create per-app resources in Flagsmith, Sentry, and Honeycomb."
echo ""
echo "The tokens below are YOUR personal SaaS-account setup tokens. They are used"
echo "only locally, only while this script runs, to provision per-app resources."
echo "Do NOT store them in the repo or in GitHub Actions secrets — the deploy"
echo "workflow never uses them. The only values the app needs at runtime (the"
echo "per-app API key / DSN) are stored as Pulumi config secrets (shown at the end)."
echo ""
echo "Set the following env vars before running:"
echo "  FLAGSMITH_SERVER_API_KEY — admin token from Flagsmith account settings"
echo "  SENTRY_AUTH_TOKEN        — auth token from Sentry account settings"
echo "  SENTRY_ORG               — your Sentry organisation slug"
echo "  SENTRY_TEAM              — your Sentry team slug (defaults to SENTRY_ORG)"
echo "  HONEYCOMB_CONFIGURATION_API_KEY — Honeycomb configuration key, only if"
echo "                                     you want this script to create a dataset"
echo ""
echo "Runtime keys you store in Pulumi config are different:"
echo "  FLAGSMITH_API_KEY  — server-side environment key"
echo "  SENTRY_DSN         — project DSN"
echo "  HONEYCOMB_API_KEY  — ingest key"
echo ""

# ── Flagsmith ────────────────────────────────────────────────────────────────
if [[ -z "${FLAGSMITH_SERVER_API_KEY:-}" ]]; then
    echo "SKIP Flagsmith: FLAGSMITH_SERVER_API_KEY not set."
    echo "  → Create a project manually at https://flagsmith.com, then store its"
    echo "    server-side environment key as the Pulumi config secret 'flagsmith_api_key'"
    echo "    (see the summary at the end)."
else
    echo "Creating Flagsmith project: ${APP_NAME} …"
    ORG_ID=$(curl -sf "https://api.flagsmith.com/api/v1/organisations/" \
        -H "Authorization: Token ${FLAGSMITH_SERVER_API_KEY}" \
        | python3 -c 'import sys,json; print(json.load(sys.stdin)["results"][0]["id"])')
    curl -sf -X POST "https://api.flagsmith.com/api/v1/projects/" \
        -H "Authorization: Token ${FLAGSMITH_SERVER_API_KEY}" \
        -H "Content-Type: application/json" \
        -d "{\"name\": \"${APP_DISPLAY_NAME}\", \"organisation\": ${ORG_ID}}" \
        > /dev/null
    echo "  ✓ Flagsmith project created."
    echo "  → Copy the server-side environment key from the Flagsmith dashboard and store"
    echo "    it as the Pulumi config secret 'flagsmith_api_key' (see summary below)."
fi

echo ""

# ── Sentry ───────────────────────────────────────────────────────────────────
if [[ -z "${SENTRY_AUTH_TOKEN:-}" ]] || [[ -z "${SENTRY_ORG:-}" ]]; then
    echo "SKIP Sentry: SENTRY_AUTH_TOKEN or SENTRY_ORG not set."
    echo "  → Create a project manually at https://sentry.io, then store its DSN"
    echo "    as the Pulumi config secret 'sentry_dsn' (see summary below)."
else
    # The create-project endpoint is scoped to a TEAM, whose slug is often NOT
    # the same as the org slug. Set SENTRY_TEAM explicitly; default to the org
    # slug only as a last resort.
    SENTRY_TEAM="${SENTRY_TEAM:-$SENTRY_ORG}"
    echo "Creating Sentry project: ${APP_NAME} (org=${SENTRY_ORG}, team=${SENTRY_TEAM}) …"
    if curl -sf -X POST "https://sentry.io/api/0/teams/${SENTRY_ORG}/${SENTRY_TEAM}/projects/" \
        -H "Authorization: Bearer ${SENTRY_AUTH_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "{\"name\": \"${APP_DISPLAY_NAME}\", \"slug\": \"${APP_NAME}\", \"platform\": \"python-fastapi\"}" \
        > /dev/null; then
        echo "  ✓ Sentry project created."
        echo "  → Retrieve the DSN from https://sentry.io/settings/${SENTRY_ORG}/projects/${APP_NAME}/keys/"
        echo "    and store it as the Pulumi config secret 'sentry_dsn' (see summary below)."
    else
        echo "  ✗ Sentry project creation failed (often a 403: many orgs block"
        echo "    member project creation, or SENTRY_TEAM is wrong)."
        echo "  → Create the project manually in the Sentry UI, then copy its DSN"
        echo "    and store it as the Pulumi config secret 'sentry_dsn' (see summary below)."
    fi
fi

echo ""

# ── Honeycomb ────────────────────────────────────────────────────────────────
if [[ -z "${HONEYCOMB_CONFIGURATION_API_KEY:-}" ]]; then
    echo "SKIP Honeycomb: HONEYCOMB_CONFIGURATION_API_KEY not set."
    echo "  → Use a Honeycomb ingest key as the Pulumi config secret"
    echo "    'honeycomb_api_key'. Honeycomb can auto-create the service/dataset, or"
    echo "    you can create '${APP_NAME}' manually in the UI first."
else
    echo "Creating Honeycomb dataset: ${APP_NAME} …"
    curl -sf -X POST "https://api.honeycomb.io/1/datasets" \
        -H "X-Honeycomb-Team: ${HONEYCOMB_CONFIGURATION_API_KEY}" \
        -H "Content-Type: application/json" \
        -d "{\"name\": \"${APP_NAME}\"}" \
        > /dev/null
    echo "  ✓ Honeycomb dataset created."
    echo "  → Store a Honeycomb ingest key as the Pulumi config secret"
    echo "    'honeycomb_api_key'. Do not use the configuration key at runtime."
fi

echo ""

# ── Clerk ────────────────────────────────────────────────────────────────────
echo "=== MANUAL STEP: Clerk ==="
echo "  1. Go to https://dashboard.clerk.com"
echo "  2. Create a new Application named '${APP_DISPLAY_NAME}'"
echo "  3. Use the DEVELOPMENT instance keys (sk_test_... / pk_test_...). A"
echo "     production (sk_live_) instance requires a custom domain, which the"
echo "     default *.ondigitalocean.app host cannot satisfy."
echo "  4. Add the Secret Key as CLERK_SECRET_KEY (Pulumi config secret), and"
echo "     the Publishable Key as clerk_publishable_key (Pulumi config, non-secret)."

echo ""
echo "=== Setup complete ==="
echo ""
echo "Store each key as a Pulumi config secret so Pulumi can inject it into"
echo "App Platform at deploy time. From the infra/ directory:"
echo ""
echo "  cd infra"
echo "  pulumi stack init prod   # first time only — you create and own this stack"
echo "  pulumi config set --secret clerk_secret_key  <CLERK_SECRET_KEY>"
echo "  pulumi config set --secret flagsmith_api_key <FLAGSMITH_API_KEY>"
echo "  pulumi config set --secret sentry_dsn        <SENTRY_DSN>"
echo "  pulumi config set --secret honeycomb_api_key <HONEYCOMB_API_KEY>"
{%- if include_frontend %}
echo "  pulumi config set clerk_publishable_key <CLERK_PUBLISHABLE_KEY>   # frontend only, non-secret"
{%- endif %}
echo ""
echo "Then deploy:"
echo "  pulumi up"
echo ""
echo "Note: PULUMI_ACCESS_TOKEN and DIGITALOCEAN_TOKEN are the only values that go"
echo "in GitHub Actions secrets (gh secret set) — they are CI credentials. SaaS"
echo "setup-only tokens above are local-only and belong in neither GitHub nor Pulumi."
