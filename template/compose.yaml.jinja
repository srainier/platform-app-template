# Local development services for {{ app_display_name }}.
# Matches the connection strings in .env.example.
#
# Versions mirror what platform-infra deploys to production:
#   - PostgreSQL 18 (managed DO cluster)
#   - Valkey 8 (managed DO cluster — DO replaced Redis with Valkey in mid-2025)
#
# Usage:
#   docker compose up -d      # start in background
#   docker compose down       # stop and remove containers
#   docker compose down -v    # also delete persisted data volumes

services:
  postgres:
    image: postgres:18
    environment:
      POSTGRES_USER: user
      POSTGRES_PASSWORD: password
      POSTGRES_DB: {{ app_name | replace('-', '_') }}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U user"]
      interval: 5s
      timeout: 5s
      retries: 5

  valkey:
    image: valkey/valkey:8
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  postgres_data:
