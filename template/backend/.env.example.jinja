# {{ app_display_name }} backend environment
# Copy this file to backend/.env for local development.

# Local: start postgres with docker compose up
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/{{ app_name | replace('-', '_') }}

# Local: start valkey with docker compose up. Uses redis:// because Valkey
# speaks the Redis wire protocol, so standard Redis clients work unchanged.
REDIS_URL=redis://localhost:6379/0

DEBUG=true
ENVIRONMENT=development

# SaaS dev keys. All optional: each integration degrades gracefully when its
# key is empty (/me and /notes return 503 without CLERK_SECRET_KEY; spans print
# to the console without HONEYCOMB_API_KEY). Fill them from this app's Pulumi
# config, without echoing secrets, by running: bash scripts/dev-env.sh
CLERK_SECRET_KEY=
FLAGSMITH_API_KEY=
SENTRY_DSN=
HONEYCOMB_API_KEY=
