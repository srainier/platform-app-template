[project]
name = "{{ app_name }}"
version = "0.1.0"
description = "{{ app_display_name }} backend"
requires-python = ">=3.13"
dependencies = [
    "fastapi[standard]>=0.135",
    "sqlalchemy[asyncio]>=2.0.49",
    "asyncpg>=0.31",
    "pydantic-settings>=2.13",
    "redis>=7.4",
    "clerk-backend-api>=2.0",
    "flagsmith>=3.8",
    "opentelemetry-sdk>=1.30",
    "opentelemetry-exporter-otlp-proto-http>=1.30",
    "opentelemetry-instrumentation-fastapi>=0.51b0",
    "sentry-sdk[fastapi]>=2.0",
]

[dependency-groups]
dev = [
    "pytest>=9.0",
    "pytest-asyncio>=1.3",
    "httpx>=0.28",
    "pyright>=1.1.408",
    "ruff>=0.15",
]

[tool.pytest.ini_options]
asyncio_mode = "auto"

[tool.pyright]
typeCheckingMode = "strict"
pythonVersion = "3.13"

[tool.ruff]
target-version = "py313"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "UP", "B", "SIM"]

[tool.ruff.format]
quote-style = "double"

[tool.uv]
package = false
