# {{ app_display_name }} — environment variables
# Copy backend/.env.example to backend/.env for local backend development.
{% if include_frontend -%}
# Copy frontend/.env.example to frontend/.env.local for local frontend development.
{% endif -%}
# In production these are injected as App Platform secrets by Pulumi.

# ── Database ─────────────────────────────────────────────────────────────────
# Local: start postgres with docker compose up
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/{{ app_name | replace('-', '_') }}

# ── Valkey (Redis-compatible) ────────────────────────────────────────────────
# Local: start valkey with docker compose up. Uses redis:// scheme — Valkey
# speaks the Redis wire protocol, so standard Redis clients work unchanged.
REDIS_URL=redis://localhost:6379/0

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development
{% if include_frontend %}

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
{% endif %}

# ── SaaS (set after running scripts/setup-saas.sh) ───────────────────────────
# CLERK_SECRET_KEY=sk_test_replace_me
# FLAGSMITH_API_KEY=...
# SENTRY_DSN=https://...@sentry.io/...
# HONEYCOMB_API_KEY=...
