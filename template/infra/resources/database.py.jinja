import pulumi
import pulumi_digitalocean as do

from . import platform

db = do.DatabaseDb(
    "{{ app_name }}-db",
    cluster_id=platform.postgres_cluster_id,
    name="{{ app_name | replace('-', '_') }}",
)

db_user = do.DatabaseUser(
    "{{ app_name }}-db-user",
    cluster_id=platform.postgres_cluster_id,
    name="{{ app_name | replace('-', '_') }}_user",
)

# Per-app PgBouncer pool on the shared cluster. Transaction-mode pooling keeps
# the cluster's connection count bounded when multiple apps or instances are
# active. DO's pools are per-database, so platform-infra's pool can't be reused.
db_pool = do.DatabaseConnectionPool(
    "{{ app_name }}-db-pool",
    cluster_id=platform.postgres_cluster_id,
    name="{{ app_name | replace('-', '_') }}_pool",
    mode="transaction",
    # The shared db-s-1vcpu-1gb cluster has ~22 pooled connections and
    # platform-pool already reserves 10; keep this modest so several apps can
    # coexist on one cluster.
    size=5,
    db_name=db.name,
    user=db_user.name,
)

# DATABASE_URL routes through the pool, not the cluster directly.
#
# Two non-obvious requirements for App Platform + a DO managed cluster:
#   1. PUBLIC host, not private. App Platform components are not members of the
#      VPC, so they cannot reach the pool's private hostname
#      (private-*.db.ondigitalocean.com). They must connect over the public
#      host, with the app registered as a trusted source to gate access.
#   2. POOL name as the database. Connecting through the PgBouncer pool
#      (port 25061), the connection's "database" segment must be the pool name,
#      not the underlying db — PgBouncer routes by pool name and otherwise
#      reports "no such database".
database_url: pulumi.Output[str] = pulumi.Output.all(
    host=db_pool.host,
    port=db_pool.port,
    user=db_user.name,
    password=db_user.password,
    db=db_pool.name,
).apply(
    lambda args: (
        f"postgresql+asyncpg://{args['user']}:{args['password']}"
        f"@{args['host']}:{args['port']}/{args['db']}"
    )
)
