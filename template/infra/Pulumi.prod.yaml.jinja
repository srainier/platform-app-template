# Runtime config for the prod stack. CI reads this file, so commit it.
# Secret values are stored encrypted; set each one by copying it in the vendor UI
# and piping the clipboard (keeps it out of shell history):
#   pbpaste | pulumi config set --secret clerk_secret_key
#   pbpaste | pulumi config set --secret flagsmith_api_key
#   pbpaste | pulumi config set --secret sentry_dsn
#   pbpaste | pulumi config set --secret honeycomb_api_key
{%- if include_frontend %}
#   pbpaste | pulumi config set clerk_publishable_key   # public, not secret
{%- endif %}
# Which key to copy from each vendor: docs/credentials.md in platform-app-template.
config:
  {{ app_name }}:do_region: nyc3
  {{ app_name }}:environment: prod
