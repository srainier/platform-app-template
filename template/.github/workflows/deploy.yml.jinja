name: Deploy

on:
  push:
    branches: [main]

jobs:
  deploy-infra:
    name: Pulumi Up
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
        with:
          version: latest
      - name: Install infra dependencies
        working-directory: infra
        run: uv sync
      - name: Pulumi Up
        working-directory: infra
        run: uv run pulumi up --yes --stack prod
{% raw %}
        env:
          PULUMI_ACCESS_TOKEN: ${{ secrets.PULUMI_ACCESS_TOKEN }}
          DIGITALOCEAN_TOKEN: ${{ secrets.DIGITALOCEAN_TOKEN }}
{% endraw %}
{% if include_frontend %}

  deploy-frontend:
    name: Deploy Frontend
    runs-on: ubuntu-latest
    needs: deploy-infra
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - name: Install
        working-directory: frontend
        run: npm ci
      - name: Build
        working-directory: frontend
        run: npm run build
{% raw %}
        env:
          NEXT_PUBLIC_API_URL: ${{ vars.NEXT_PUBLIC_API_URL }}
{% endraw %}
      # TODO: Add Vercel deploy step or configure DO App Platform static site
      # For Vercel: use amondnet/vercel-action@v25 with VERCEL_TOKEN secret
{% endif %}
