name: Checks

on:
  pull_request:
    branches: [main]

jobs:
  backend-typecheck:
    name: Backend — Pyright
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: astral-sh/setup-uv@v8
        with:
          version: latest
      - name: Install dependencies
        working-directory: backend
        run: uv sync --group dev
      - name: Pyright
        working-directory: backend
        run: uv run pyright

  backend-lint:
    name: Backend — Ruff
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: astral-sh/setup-uv@v8
        with:
          version: latest
      - name: Install dependencies
        working-directory: backend
        run: uv sync --group dev
      - name: Ruff lint
        working-directory: backend
        run: uv run ruff check .
      - name: Ruff format check
        working-directory: backend
        run: uv run ruff format --check .

  backend-test:
    name: Backend — Pytest
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: astral-sh/setup-uv@v8
        with:
          version: latest
      - name: Install dependencies
        working-directory: backend
        run: uv sync --group dev
      - name: Pytest
        working-directory: backend
        run: uv run pytest
{% if include_frontend %}

  frontend-build:
    name: Frontend — Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-node@v6
        with:
          node-version: "24"
          cache: "npm"
          cache-dependency-path: frontend/package.json
      - name: Install
        working-directory: frontend
        run: npm install
      - name: Build static export
        working-directory: frontend
        # NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY must be present at build time or
        # ClerkProvider throws during static prerender. This is a well-formed
        # but inert dummy key so the build smoke-test passes; the real
        # publishable key is injected by App Platform at deploy time.
        env:
          NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY: pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk
        run: npm run build

  frontend-lint:
    name: Frontend — Biome
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-node@v6
        with:
          node-version: "24"
          cache: "npm"
          cache-dependency-path: frontend/package.json
      - name: Install
        working-directory: frontend
        run: npm install
      - name: Biome check
        working-directory: frontend
        run: npx biome check .
{% endif %}
